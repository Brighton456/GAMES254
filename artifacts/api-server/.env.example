# --- Required by the app ---
PORT=50001

# --- BrightPay (deposit STK push + withdrawals) ---
# Without these the proxy 503s fail-closed (no silent credit).
BRIGHTPAY_API_KEY=
BRIGHTPAY_SIGNING_SECRET=
BRIGHTPAY_WITHDRAWALS_ENABLED=true

# --- Games254 Supabase wallet ledger (optional; skip for proxy-only) ---
# The Supabase project URL + a publishable/legacy anon key. Writes go through
# SECURITY DEFINER RPC functions (see artifacts/nairobi-checkers/supabase/migrations),
# never direct table access, so the anon key is safe here.
SUPABASE_URL=https://aqsvdmramlaxuwpmaxzu.supabase.co
SUPABASE_ANON_KEY=

# --- Force HTTPS (Beast/Express behind proxy) ---
# TRUST_PROXY=1